# Local dev defaults to /api/v1 and uses Vite proxy.
# Set only if you want to bypass proxy and call API directly.
# VITE_API_BASE_URL=http://localhost:8000/api/v1

# Optional target for local proxy (/api/v1 -> target).
# Use local backend by default, or set this to your deployed backend:
# VITE_DEV_PROXY_TARGET=https://enterprise-rag-assistant-api-7lz0.onrender.com
# Optional explicit base path for GitHub Pages deployments:
# - user site repo (e.g. sagarmahewar.github.io): use /
# - project repo: use /<repo-name>/
# VITE_BASE_PATH=/Enterprise-RAG-Assistant/
