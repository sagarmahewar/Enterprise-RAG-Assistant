{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Enterprise RAG eval case",
  "type": "object",
  "required": [
    "id",
    "question",
    "expected_answer",
    "relevant_chunk_ids",
    "expected_citations",
    "tags"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "expected_answer": {
      "type": "string",
      "minLength": 1
    },
    "relevant_chunk_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "expected_citations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "document",
          "page"
        ],
        "properties": {
          "document": {
            "type": "string",
            "minLength": 1
          },
          "page": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "document_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}
